# Monad testnet RPC (optional; defaults to viem's monadTestnet RPC)
NEXT_PUBLIC_RPC_URL=

# Kadd testnet venue (contracts/script/DeployVenue.s.sol). Swaps, the tUSDC faucet and clubs need all three.
NEXT_PUBLIC_VENUE=0xe4c0c88a4b2e5b150D3bB8D3d391E6A87b3d5379
NEXT_PUBLIC_TUSDC=0x9173048f7c1D6ebfC72a1932C8d15E3EADE180CB
NEXT_PUBLIC_CLUB_FACTORY=0x4E24bA0762624EAa63E02f3834105efa423A624c
NEXT_PUBLIC_STRATEGIES=0xC12684b7063e3C749f0227539601a7b370073cEA
# Auto copy trading vaults (contracts/script/DeployCopy.s.sol).
NEXT_PUBLIC_COPY=0x27bB7D06AF7BA8Ea359CFe00A628145ED0Bf1661
# Copy clubs (contracts/script/DeployCopyClubs.s.sol).
NEXT_PUBLIC_COPY_CLUBS=0x67A974949d2918e07763C86cfe8bbc3E817930D2
# KaddCopyKuru on Monad mainnet (contracts/src/KaddCopyKuru.sol). Not deployed; empty = "coming soon".
NEXT_PUBLIC_COPY_MAINNET=

# Optional: CoinGecko API key (free Demo plan is enough). Market data then goes through CoinGecko's onchain API with a
# per-key rate limit instead of GeckoTerminal's per-IP one, which shared cloud IPs often exhaust. https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Envio HyperRPC token for /stats trade, volume and wallet counts (server-only). Create at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Kadd's Envio HyperIndex indexer (/indexer), deployed on Envio Cloud. When set, Stats and the Kadd leaderboard read
# from it; otherwise they scan logs through HyperRPC with ENVIO_API_TOKEN.
ENVIO_INDEXER_URL=

# Gas drip (server-only): a dedicated testnet-only wallet that sends new passkey accounts a little MON for gas.
# Create one with `cast wallet new`, fund it with testnet MON, never reuse a wallet that holds anything real.
DRIP_PRIVATE_KEY=
DRIP_AMOUNT_MON=0.25

# Copy-trading keeper (server-only): signs KaddCopy.copyBuy / copySell. Must be the KEEPER set at deploy. Falls back to
# DRIP_PRIVATE_KEY, so the gas drip wallet can be the keeper. Testnet-only key; it never holds user funds.
KEEPER_PRIVATE_KEY=
